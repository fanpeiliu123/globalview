# Supabase — copy to .env.local (gitignored) and fill in.
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Service role key (SECRET — server/CLI/build only, never expose to the browser).
# Used by scripts/db-push.mjs and scripts/db-export.mjs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key
